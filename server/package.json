{
  "name": "@interviewiq/server",
  "version": "2.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "node ../node_modules/typescript/bin/tsc -p .",
    "dev": "node ../node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "worker": "node ../node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/worker.ts",
    "start": "node dist/server.js",
    "test": "node ../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../node_modules/vitest/vitest.mjs",
    "lint": "node ../node_modules/typescript/bin/tsc -p . --noEmit"
  },
  "dependencies": {
    "@interviewiq/shared": "*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
