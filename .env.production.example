# =============================================================================
# INTERVIEWIQ 2.0 — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

NODE_ENV=production
PORT=5000
CLIENT_URL=https://interviewiq.ai

# Database Connections
MONGODB_URI=mongodb://mongodb:27017/interviewiq
POSTGRES_URL=postgresql://postgres:YOUR_STRONG_POSTGRES_PASSWORD@postgres:5432/interviewiq
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=YOUR_MIN_32_CHARACTERS_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY!
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://interviewiq.ai

# AI Multi-Provider Orchestration
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Payment Processing & Billing
RAZORPAY_KEY_ID=rzp_live_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_KEY
