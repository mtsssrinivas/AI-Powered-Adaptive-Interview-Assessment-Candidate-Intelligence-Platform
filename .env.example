# ==========================================
# InterviewIQ 2.0 Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_interviewiq_dev_min32chars_long!
JWT_EXPIRES_IN=7d

# Databases
MONGODB_URI=mongodb://localhost:27017/interviewiq
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/interviewiq
REDIS_URL=redis://localhost:6379

# AI Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Client Configuration (Prefix with VITE_)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key
